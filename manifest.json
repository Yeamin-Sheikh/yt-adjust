{
  "manifest_version": 3,
  "name": "YT Adjust",
  "version": "2.4.2",
  "description": "Lightweight YouTube enhancer — auto quality, sponsor skip, volume gesture, speed control, volume boost, mini-player, and picture-in-picture.",
  "author": "Sheikh Technology LLC",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://*.youtube.com/*", "https://sponsor.ajay.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT Adjust",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "exclude_matches": [
        "https://studio.youtube.com/*",
        "https://music.youtube.com/*",
        "https://accounts.youtube.com/*",
        "https://tv.youtube.com/*"
      ],
      "js": ["content/isolated.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "exclude_matches": [
        "https://studio.youtube.com/*",
        "https://music.youtube.com/*",
        "https://accounts.youtube.com/*",
        "https://tv.youtube.com/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
