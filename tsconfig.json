{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.d.ts",
    "content/**/*.js",
    "popup/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".agents"
  ]
}
